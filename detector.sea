-- detector.sea — QR Code image preprocessing, 1:1:3:1:1 Finder Pattern detection, and grid extraction.

local tables = require("./tables")
local matrix = require("./matrix")

local M = {}

-- Compute Otsu's global threshold (0..255) on a grayscale Image
function M.otsu_threshold(img)
    local hist = int_array(256)
    for _ = 0, 255 do hist[] = 0 end
    local total = img.width * img.height
    if total == 0 then return 128 end

    local data = img.data
    for i = 0, total - 1 do
        local v = data[i]
        hist[v] = hist[v] + 1
    end

    local sum_all = 0.0
    for t = 0, 255 do
        sum_all += t * hist[t]
    end

    local sum_b = 0.0
    local w_b = 0
    local max_var = -1.0
    local threshold = 128

    for t = 0, 255 do
        w_b += hist[t]
        if w_b == 0 then continue end
        local w_f = total - w_b
        if w_f == 0 then break end
        sum_b += t * hist[t]
        local m_b = sum_b / w_b
        local m_f = (sum_all - sum_b) / w_f
        local diff = m_b - m_f
        local between = w_b * w_f * diff * diff
        if between > max_var then
            max_var = between
            threshold = t
        end
    end
    return threshold
end

-- Build a binary array (1 = dark, 0 = light) of length w * h using Otsu threshold
function M.binarize_otsu(img, invert)
    local thr = M.otsu_threshold(img)
    local n = img.width * img.height
    local bits = int_array(n)
    local inv = invert and 1 or 0
    local data = img.data
    for i = 0, n - 1 do
        local b = (data[i] <= thr) and 1 or 0
        bits[] = b ~ inv
    end
    return bits, thr
end

-- Build a binary array (1 = dark, 0 = light) using fast integral-image adaptive threshold
function M.binarize_adaptive(img, invert)
    local w = img.width
    local h = img.height
    local n = w * h
    local integral = int_array(n)
    for _ = 0, n - 1 do integral[] = 0 end
    local data = img.data

    for y = 0, h - 1 do
        local row_sum = 0
        local row_off = y * w
        for x = 0, w - 1 do
            row_sum += data[row_off + x]
            if y > 0 then
                integral[row_off + x] = integral[(y - 1) * w + x] + row_sum
            else
                integral[row_off + x] = row_sum
            end
        end
    end

    local radius = math.max(7, math.min(w, h) // 16)
    local bits = int_array(n)
    local inv = invert and 1 or 0

    for y = 0, h - 1 do
        local y0 = math.max(0, y - radius)
        local y1 = math.min(h - 1, y + radius)
        local row_off = y * w
        for x = 0, w - 1 do
            local x0 = math.max(0, x - radius)
            local x1 = math.min(w - 1, x + radius)
            local area = (x1 - x0 + 1) * (y1 - y0 + 1)
            local sum = integral[y1 * w + x1]
            if x0 > 0 then sum -= integral[y1 * w + (x0 - 1)] end
            if y0 > 0 then sum -= integral[(y0 - 1) * w + x1] end
            if x0 > 0 and y0 > 0 then sum += integral[(y0 - 1) * w + (x0 - 1)] end
            local mean = sum // area
            local b = (data[row_off + x] < mean - 5) and 1 or 0
            bits[] = b ~ inv
        end
    end
    return bits
end

-- Check if 5 run lengths [n0, n1, n2, n3, n4] match the 1:1:3:1:1 QR Finder Pattern ratio
local function check_finder_ratio(n0, n1, n2, n3, n4)
    if n0 <= 0 or n1 <= 0 or n2 <= 0 or n3 <= 0 or n4 <= 0 then
        return false, 0
    end
    local total = n0 + n1 + n2 + n3 + n4
    if total < 7 then
        return false, 0
    end
    local mod_size = total / 7.0
    local max_var = mod_size * 0.65
    if math.abs(mod_size - n0) <= max_var and
        math.abs(mod_size - n1) <= max_var and
        math.abs(3.0 * mod_size - n2) <= 3.0 * max_var and
        math.abs(mod_size - n3) <= max_var and
        math.abs(mod_size - n4) <= max_var then
        return true, total
    end
    return false, 0
end

-- Measure vertical 1:1:3:1:1 run through (cx, start_y) where (cx, start_y) is dark
local function cross_check_vertical(bits, w, h, cx, start_y, max_count)
    local x = math.floor(cx)
    if x < 0 or x >= w then return nil end

    local y = start_y
    if bits[y * w + x] == 0 then return nil end

    -- Count center dark run (s2)
    local s0 = 0
    local s1 = 0
    local s2 = 0
    local s3 = 0
    local s4 = 0

    while y >= 0 and bits[y * w + x] == 1 do
        s2 += 1
        y -= 1
    end
    if y < 0 then return nil end
    while y >= 0 and bits[y * w + x] == 0 and s1 <= max_count do
        s1 += 1
        y -= 1
    end
    if y < 0 or s1 > max_count then return nil end
    while y >= 0 and bits[y * w + x] == 1 and s0 <= max_count do
        s0 += 1
        y -= 1
    end
    if s0 > max_count then return nil end

    y = start_y + 1
    while y < h and bits[y * w + x] == 1 do
        s2 += 1
        y += 1
    end
    if y >= h then return nil end
    while y < h and bits[y * w + x] == 0 and s3 <= max_count do
        s3 += 1
        y += 1
    end
    if y >= h or s3 > max_count then return nil end
    while y < h and bits[y * w + x] == 1 and s4 <= max_count do
        s4 += 1
        y += 1
    end
    if s4 > max_count then return nil end

    local ok, total = check_finder_ratio(s0, s1, s2, s3, s4)
    if not ok then return nil end
    local end_y = y
    local center_y = end_y - s4 - s3 - s2 / 2.0
    return center_y, total
end

-- Verify diagonal 1:1:3:1:1 run through (cx, cy)
local function cross_check_diagonal(bits, w, h, cx, cy, max_count)
    local ix = math.floor(cx)
    local iy = math.floor(cy)
    if ix < 0 or ix >= w or iy < 0 or iy >= h or bits[iy * w + ix] == 0 then
        return false
    end
    local s0 = 0
    local s1 = 0
    local s2 = 0
    local s3 = 0
    local s4 = 0

    local d = 0
    while iy - d >= 0 and ix - d >= 0 and bits[(iy - d) * w + (ix - d)] == 1 do
        s2 += 1
        d += 1
    end
    if iy - d < 0 or ix - d < 0 then return false end
    while iy - d >= 0 and ix - d >= 0 and bits[(iy - d) * w + (ix - d)] == 0 and s1 <= max_count do
        s1 += 1
        d += 1
    end
    if iy - d < 0 or ix - d < 0 or s1 > max_count then return false end
    while iy - d >= 0 and ix - d >= 0 and bits[(iy - d) * w + (ix - d)] == 1 and s0 <= max_count do
        s0 += 1
        d += 1
    end

    d = 1
    while iy + d < h and ix + d < w and bits[(iy + d) * w + (ix + d)] == 1 do
        s2 += 1
        d += 1
    end
    if iy + d >= h or ix + d >= w then return false end
    while iy + d < h and ix + d < w and bits[(iy + d) * w + (ix + d)] == 0 and s3 <= max_count do
        s3 += 1
        d += 1
    end
    if iy + d >= h or ix + d >= w or s3 > max_count then return false end
    while iy + d < h and ix + d < w and bits[(iy + d) * w + (ix + d)] == 1 and s4 <= max_count do
        s4 += 1
        d += 1
    end

    local total = s0 + s1 + s2 + s3 + s4
    if total < 7 then return false end
    local mod_size = total / 7.0
    local max_var = mod_size * 0.85
    return math.abs(mod_size - s0) <= max_var and
        math.abs(mod_size - s1) <= max_var and
        math.abs(3.0 * mod_size - s2) <= 3.0 * max_var and
        math.abs(mod_size - s3) <= max_var and
        math.abs(mod_size - s4) <= max_var
end

-- Find all Finder Pattern centers in `bits` (w x h)
function M.find_finder_patterns(bits, w, h)
    local clusters = []

    local function register_center(cx, cy, mod_size)
        for _, c in clusters do
            local dx = c.x - cx
            local dy = c.y - cy
            local dist = math.sqrt(dx * dx + dy * dy)
            if dist <= math.max(c.mod_size, mod_size) * 2.5 and
                math.abs(c.mod_size - mod_size) <= math.max(c.mod_size, mod_size) * 0.6 then
                local cnt = c.count + 1
                c.x = (c.x * c.count + cx) / cnt
                c.y = (c.y * c.count + cy) / cnt
                c.mod_size = (c.mod_size * c.count + mod_size) / cnt
                c.count = cnt
                return
            end
        end
        clusters[] = {x = cx, y = cy, mod_size = mod_size, count = 1}
    end

    for y = 0, h - 1 do
        local row_off = y * w
        local s0 = 0
        local s1 = 0
        local s2 = 0
        local s3 = 0
        local s4 = 0
        local state = 0

        for x = 0, w - 1 do
            local p = bits[row_off + x]
            if p == 1 then
                if state == 1 or state == 3 then
                    state += 1
                end
                if state == 0 then
                    s0 += 1
                elseif state == 2 then
                    s2 += 1
                elseif state == 4 then
                    s4 += 1
                end
            else
                if state == 0 then
                    if s0 > 0 then
                        state = 1
                        s1 = 1
                    end
                elseif state == 1 then
                    s1 += 1
                elseif state == 2 then
                    state = 3
                    s3 = 1
                elseif state == 3 then
                    s3 += 1
                elseif state == 4 then
                    local ok, total_w = check_finder_ratio(s0, s1, s2, s3, s4)
                    if ok then
                        local cx = x - s4 - s3 - s2 / 2.0
                        local cy, total_h = cross_check_vertical(bits, w, h, cx, y, s2 * 2)
                        if cy ~= nil and math.abs(total_w - total_h) <= math.max(total_w, total_h) * 0.4 then
                            if cross_check_diagonal(bits, w, h, cx, cy, s2 * 2) then
                                local mod_est = (total_w + total_h) / 14.0
                                register_center(cx, cy, mod_est)
                            end
                        end
                    end
                    s0 = s2
                    s1 = s3
                    s2 = s4
                    s3 = 1
                    s4 = 0
                    state = 3
                end
            end
        end

        if state == 4 then
            local ok, total_w = check_finder_ratio(s0, s1, s2, s3, s4)
            if ok then
                local cx = w - s4 - s3 - s2 / 2.0
                local cy, total_h = cross_check_vertical(bits, w, h, cx, y, s2 * 2)
                if cy ~= nil and math.abs(total_w - total_h) <= math.max(total_w, total_h) * 0.4 then
                    if cross_check_diagonal(bits, w, h, cx, cy, s2 * 2) then
                        local mod_est = (total_w + total_h) / 14.0
                        register_center(cx, cy, mod_est)
                    end
                end
            end
        end
    end

    sort.by(clusters, "count", true)
    return clusters
end

local function dist2d(a, b)
    local dx = a.x - b.x
    local dy = a.y - b.y
    return math.sqrt(dx * dx + dy * dy)
end

-- Select the best 3 Finder Patterns and order them as { tl, tr, bl }
function M.select_finder_triad(clusters)
    local n = math.min(len(clusters), 12)
    if n < 3 then return nil end

    local best_triad = nil
    local best_score = 1000000000.0

    for i = 0, n - 3 do
        for j = i + 1, n - 2 do
            for k = j + 1, n - 1 do
                local p0 = clusters[i]
                local p1 = clusters[j]
                local p2 = clusters[k]

                local avg_mod = (p0.mod_size + p1.mod_size + p2.mod_size) / 3.0
                if math.abs(p0.mod_size - avg_mod) > avg_mod * 0.5 or
                    math.abs(p1.mod_size - avg_mod) > avg_mod * 0.5 or
                    math.abs(p2.mod_size - avg_mod) > avg_mod * 0.5 then
                    continue
                end

                local d01 = dist2d(p0, p1)
                local d12 = dist2d(p1, p2)
                local d02 = dist2d(p0, p2)

                -- Identify hypotenuse (longest side) -> opposite vertex is Top-Left (tl)
                local tl = p0
                local b = p1
                local c = p2
                local hyp = d12
                local s_a = d01
                local s_b = d02

                if d01 >= d12 and d01 >= d02 then
                    tl = p2
                    b = p0
                    c = p1
                    hyp = d01
                    s_a = d02
                    s_b = d12
                elseif d02 >= d01 and d02 >= d12 then
                    tl = p1
                    b = p0
                    c = p2
                    hyp = d02
                    s_a = d01
                    s_b = d12
                end

                if s_a < avg_mod * 10 or s_b < avg_mod * 10 then
                    continue
                end

                -- Side lengths s_a and s_b should be similar, and hyp ~= sqrt(s_a^2 + s_b^2)
                local side_diff = math.abs(s_a - s_b) / math.max(s_a, s_b)
                local expected_hyp = math.sqrt(s_a * s_a + s_b * s_b)
                local hyp_diff = math.abs(hyp - expected_hyp) / expected_hyp

                if side_diff < 0.25 and hyp_diff < 0.25 then
                    local score = side_diff + hyp_diff - (p0.count + p1.count + p2.count) * 0.001
                    if score < best_score then
                        best_score = score
                        -- Use cross product (b - tl) x (c - tl) to order TR and BL
                        local cross = (b.x - tl.x) * (c.y - tl.y) - (b.y - tl.y) * (c.x - tl.x)
                        local tr = (cross > 0) and b or c
                        local bl = (cross > 0) and c or b
                        best_triad = {tl = tl, tr = tr, bl = bl, mod_size = avg_mod}
                    end
                end
            end
        end
    end

    return best_triad
end

-- Search for the bottom-right 1:1:1 alignment pattern near (est_x, est_y)
local function find_alignment_pattern(bits, w, h, est_x, est_y, mod_size)
    local radius = math.max(4, math.floor(mod_size * 3.5))
    local cx0 = math.floor(est_x)
    local cy0 = math.floor(est_y)
    local best_x = est_x
    local best_y = est_y
    local best_err = 1000000.0
    local found = false

    for dy_i = 0, radius * 2 do
        local y = cy0 - radius + dy_i
        if y < 2 or y >= h - 2 then continue end
        for dx_i = 0, radius * 2 do
            local x = cx0 - radius + dx_i
            if x < 2 or x >= w - 2 then continue end
            if bits[y * w + x] == 1 then
                -- Check dark center (s1), surrounded by light ring (s0, s2) horizontally and vertically
                local lx = 0
                while x - 1 - lx >= 0 and bits[y * w + (x - 1 - lx)] == 1 and lx <= mod_size * 2 do lx += 1 end
                local rx = 0
                while x + 1 + rx < w and bits[y * w + (x + 1 + rx)] == 1 and rx <= mod_size * 2 do rx += 1 end
                local cw = 1 + lx + rx

                local uy = 0
                while y - 1 - uy >= 0 and bits[(y - 1 - uy) * w + x] == 1 and uy <= mod_size * 2 do uy += 1 end
                local by = 0
                while y + 1 + by < h and bits[(y + 1 + by) * w + x] == 1 and by <= mod_size * 2 do by += 1 end
                local ch = 1 + uy + by

                if cw <= mod_size * 2.2 and ch <= mod_size * 2.2 then
                    -- Verify white ring immediately outside dark center
                    local x_left = x - lx - 1
                    local x_right = x + rx + 1
                    local y_up = y - uy - 1
                    local y_down = y + by + 1
                    if x_left >= 0 and x_right < w and y_up >= 0 and y_down < h then
                        if bits[y * w + x_left] == 0 and bits[y * w + x_right] == 0 and
                            bits[y_up * w + x] == 0 and bits[y_down * w + x] == 0 then
                            local mid_x = x + (rx - lx) / 2.0
                            local mid_y = y + (by - uy) / 2.0
                            local err = math.abs(cw - mod_size) + math.abs(ch - mod_size) +
                                math.sqrt((mid_x - est_x) ^ 2 + (mid_y - est_y) ^ 2) * 0.25
                            if err < best_err then
                                best_err = err
                                best_x = mid_x
                                best_y = mid_y
                                found = true
                            end
                        end
                    end
                end
            end
        end
    end

    if found then
        return best_x, best_y, true
    end
    return est_x, est_y, false
end

-- Sample a `size x size` QR Matrix using 4 control points (TL, TR, BL, and BR/Alignment)
-- Uses bilinear / perspective interpolation on normalized coordinates in [0, 1]^2
local function sample_grid_from_triad(bits, w, h, triad, size)
    local tl = triad.tl
    local tr = triad.tr
    local bl = triad.bl
    local span = size - 7.0 -- distance in modules between finder centers (3.5 to size - 3.5)

    -- Default affine parallelogram fourth corner for finder space (size - 3.5, size - 3.5)
    local br_x = tr.x + bl.x - tl.x
    local br_y = tr.y + bl.y - tl.y

    if size >= 25 then
        -- Version >= 2 has an alignment pattern at (size - 6.5, size - 6.5)
        -- In finder-center span units, that is ratio = (size - 10) / (size - 7)
        local ratio = (size - 10.0) / span
        local est_ax = tl.x + ratio * (tr.x - tl.x) + ratio * (bl.x - tl.x)
        local est_ay = tl.y + ratio * (tr.y - tl.y) + ratio * (bl.y - tl.y)
        local ax, ay, ok = find_alignment_pattern(bits, w, h, est_ax, est_ay, triad.mod_size)
        if ok then
            -- Extrapolate from alignment center at ratio back to (1, 1) at (size - 3.5, size - 3.5)
            local corr_x = (ax - est_ax) / (ratio * ratio)
            local corr_y = (ay - est_ay) / (ratio * ratio)
            br_x += corr_x
            br_y += corr_y
        end
    end

    local mat = matrix.new(size)
    local sample_pts = [
        [0.0, 0.0],
        [-0.18, -0.18],
        [0.18, -0.18],
        [-0.18, 0.18],
        [0.18, 0.18],
    ]

    for my = 0, size - 1 do
        for mx = 0, size - 1 do
            local votes = 0
            for _, pt in sample_pts do
                local u = (mx + 0.5 + pt[0] - 3.5) / span
                local v = (my + 0.5 + pt[1] - 3.5) / span
                local px = (1.0 - u) * (1.0 - v) * tl.x +
                    u * (1.0 - v) * tr.x +
                    (1.0 - u) * v * bl.x +
                    u * v * br_x
                local py = (1.0 - u) * (1.0 - v) * tl.y +
                    u * (1.0 - v) * tr.y +
                    (1.0 - u) * v * bl.y +
                    u * v * br_y
                local ix = math.floor(px)
                local iy = math.floor(py)
                if ix >= 0 and ix < w and iy >= 0 and iy < h then
                    votes += bits[iy * w + ix]
                end
            end
            mat:set(mx, my, (votes >= 3) and 1 or 0)
        end
    end

    return mat
end

-- Fast axis-aligned bounding-box grid extractor (handles clean digital QR images of any scale/border)
function M.extract_axis_aligned(bits, w, h)
    local min_x = w
    local min_y = h
    local max_x = -1
    local max_y = -1

    for y = 0, h - 1 do
        local row_off = y * w
        for x = 0, w - 1 do
            if bits[row_off + x] == 1 then
                if x < min_x then min_x = x end
                if x > max_x then max_x = x end
                if y < min_y then min_y = y end
                if y > max_y then max_y = y end
            end
        end
    end

    if max_x < min_x or max_y < min_y then
        return []
    end

    local bw = max_x - min_x + 1
    local bh = max_y - min_y + 1
    if bw < 21 or bh < 21 then
        return []
    end

    -- Estimate module scale from top-left finder pattern's top dark bar (7 modules wide)
    -- or from horizontal 1:1:3:1:1 scan inside the top-left corner
    local candidate_sizes = []
    local seen_size = [=]
    local function add_size(s)
        if s >= 21 and s <= 177 and (s - 17) % 4 == 0 and not seen_size[s] then
            seen_size[s] = true
            candidate_sizes[] = s
        end
    end

    -- 1. Check exact integer scale factors first
    for ver = 1, 40 do
        local s = 17 + 4 * ver
        if bw % s == 0 and math.abs(bw - bh) <= math.max(2, bw // s) then
            add_size(s)
        end
    end

    -- 2. Measure top-left horizontal 1:1:3:1:1 run to estimate module size
    local max_scan_y = math.min(max_y, min_y + bh // 3)
    for y = min_y, max_scan_y do
        local x = min_x
        while x <= max_x and bits[y * w + x] == 0 do x += 1 end
        local r0 = 0
        while x <= max_x and bits[y * w + x] == 1 do r0 += 1; x += 1 end
        local r1 = 0
        while x <= max_x and bits[y * w + x] == 0 do r1 += 1; x += 1 end
        local r2 = 0
        while x <= max_x and bits[y * w + x] == 1 do r2 += 1; x += 1 end
        local r3 = 0
        while x <= max_x and bits[y * w + x] == 0 do r3 += 1; x += 1 end
        local r4 = 0
        while x <= max_x and bits[y * w + x] == 1 do r4 += 1; x += 1 end
        local ok, total = check_finder_ratio(r0, r1, r2, r3, r4)
        if ok then
            local mod_px = total / 7.0
            local raw_s = math.round(((bw + bh) / 2.0) / mod_px)
            local ver_est = math.round((raw_s - 17) / 4.0)
            for _, dv in [-1, 0, 1] do
                local v = ver_est + dv
                if v >= 1 and v <= 40 then
                    add_size(17 + 4 * v)
                end
            end
            break
        end
    end

    local results = []
    local bbox = {x = min_x, y = min_y, w = bw, h = bh}
    local corners = [
        {x = min_x, y = min_y},
        {x = max_x, y = min_y},
        {x = max_x, y = max_y},
        {x = min_x, y = max_y},
    ]

    for _, s in candidate_sizes do
        local mat = matrix.new(s)
        for my = 0, s - 1 do
            local cy = min_y + math.floor(((my + 0.5) * bh) / s)
            local y0 = min_y + math.floor(((my + 0.3) * bh) / s)
            local y1 = min_y + math.floor(((my + 0.7) * bh) / s)
            for mx = 0, s - 1 do
                local cx = min_x + math.floor(((mx + 0.5) * bw) / s)
                local x0 = min_x + math.floor(((mx + 0.3) * bw) / s)
                local x1 = min_x + math.floor(((mx + 0.7) * bw) / s)
                local votes = bits[cy * w + cx] +
                    bits[y0 * w + x0] +
                    bits[y0 * w + x1] +
                    bits[y1 * w + x0] +
                    bits[y1 * w + x1]
                mat:set(mx, my, (votes >= 3) and 1 or 0)
            end
        end
        results[] = {matrix = mat, bbox = bbox, corners = corners}
    end

    return results
end

-- Extract candidate QR matrices using Finder Pattern triad detection
function M.extract_via_finders(bits, w, h)
    local clusters = M.find_finder_patterns(bits, w, h)
    local triad = M.select_finder_triad(clusters)
    if not triad then
        return []
    end

    local d_top = dist2d(triad.tl, triad.tr)
    local d_left = dist2d(triad.tl, triad.bl)
    local avg_span_px = (d_top + d_left) / 2.0
    local est_size = 7 + math.round(avg_span_px / triad.mod_size)
    local ver_est = math.round((est_size - 17) / 4.0)
    if ver_est < 1 then ver_est = 1 end
    if ver_est > 40 then ver_est = 40 end

    local results = []
    local deltas = [0, -1, 1, -2, 2]
    for _, dv in deltas do
        local v = ver_est + dv
        if v >= 1 and v <= 40 then
            local s = 17 + 4 * v
            local mat = sample_grid_from_triad(bits, w, h, triad, s)
            local min_x = math.floor(math.min(triad.tl.x, triad.tr.x, triad.bl.x) - 3.5 * triad.mod_size)
            local min_y = math.floor(math.min(triad.tl.y, triad.tr.y, triad.bl.y) - 3.5 * triad.mod_size)
            local max_x = math.floor(math.max(triad.tl.x, triad.tr.x, triad.bl.x) + 3.5 * triad.mod_size)
            local max_y = math.floor(math.max(triad.tl.y, triad.tr.y, triad.bl.y) + 3.5 * triad.mod_size)
            local bbox = {
                x = math.max(0, min_x),
                y = math.max(0, min_y),
                w = math.min(w, max_x) - math.max(0, min_x),
                h = math.min(h, max_y) - math.max(0, min_y),
            }
            local corners = [
                {x = triad.tl.x, y = triad.tl.y},
                {x = triad.tr.x, y = triad.tr.y},
                {x = triad.tr.x + triad.bl.x - triad.tl.x, y = triad.tr.y + triad.bl.y - triad.tl.y},
                {x = triad.bl.x, y = triad.bl.y},
            ]
            results[] = {matrix = mat, bbox = bbox, corners = corners}
        end
    end

    return results
end

-- detector.detect(img [, opts]) → array of { matrix, bbox, corners }
-- Extracts candidate QR matrices from an Image using Otsu, Adaptive, and Inverted binarization.
function M.detect(img, opts)
    opts = opts or {}
    local w = img.width
    local h = img.height
    local candidates = []

    -- If image is already exact module size (17 + 4*v) with no quiet zone:
    if w == h and tables.size_to_version(w) ~= nil then
        local bits, _ = M.binarize_otsu(img, false)
        local mat = matrix.new(w)
        for i = 0, w * h - 1 do
            mat.modules[i] = bits[i]
        end
        candidates[] = {
            matrix = mat,
            bbox = {x = 0, y = 0, w = w, h = h},
            corners = [{x = 0, y = 0}, {x = w, y = 0}, {x = w, y = h}, {x = 0, y = h}],
        }
    end

    local invert_modes = [false, true]
    if opts.invert == false then
        invert_modes = [false]
    elseif opts.invert == true then
        invert_modes = [true]
    else
        -- Check border pixels: if border is predominantly dark, try inverted first
        local border_sum = 0
        local border_cnt = 0
        for x = 0, w - 1 do
            border_sum += img.data[x] + img.data[(h - 1) * w + x]
            border_cnt += 2
        end
        if border_cnt > 0 and (border_sum // border_cnt) < 128 then
            invert_modes = [true, false]
        end
    end

    for _, inv in invert_modes do
        local otsu_bits, _ = M.binarize_otsu(img, inv)
        for _, cand in M.extract_axis_aligned(otsu_bits, w, h) do
            candidates[] = cand
        end
        for _, cand in M.extract_via_finders(otsu_bits, w, h) do
            candidates[] = cand
        end

        local adapt_bits = M.binarize_adaptive(img, inv)
        for _, cand in M.extract_via_finders(adapt_bits, w, h) do
            candidates[] = cand
        end
    end

    return candidates
end

return M
