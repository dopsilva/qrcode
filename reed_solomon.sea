-- reed_solomon.sea — GF(2^8) arithmetic and Reed-Solomon encoder/decoder for QR Codes.
-- Uses primitive polynomial x^8 + x^4 + x^3 + x^2 + 1 (0x11D).

local M = {}

local EXP = int_array(512)
local LOG = int_array(256)

local function init_tables()
    for _ = 0, 511 do EXP[] = 0 end
    for _ = 0, 255 do LOG[] = 0 end
    local x = 1
    for i = 0, 254 do
        EXP[i] = x
        EXP[i + 255] = x
        LOG[x] = i
        x = x << 1
        if (x & 0x100) ~= 0 then
            x = x ~ 0x11D
        end
    end
    EXP[510] = EXP[0]
    EXP[511] = EXP[1]
end

init_tables()

M.EXP = EXP
M.LOG = LOG

-- gf_mul(a, b) → product in GF(2^8)
function M.gf_mul(a, b)
    if a == 0 or b == 0 then
        return 0
    end
    return EXP[LOG[a] + LOG[b]]
end

-- gf_div(a, b) → quotient in GF(2^8)
function M.gf_div(a, b)
    if b == 0 then
        panic("reed_solomon.gf_div: division by zero in GF(256)")
    end
    if a == 0 then
        return 0
    end
    return EXP[LOG[a] + 255 - LOG[b]]
end

-- gf_pow(a, n) → a^n in GF(2^8)
function M.gf_pow(a, n)
    if n == 0 then
        return 1
    end
    if a == 0 then
        return 0
    end
    local idx = (LOG[a] * n) % 255
    if idx < 0 then
        idx += 255
    end
    return EXP[idx]
end

-- gf_inv(a) → multiplicative inverse in GF(2^8)
function M.gf_inv(a)
    if a == 0 then
        panic("reed_solomon.gf_inv: inverse of zero in GF(256)")
    end
    return EXP[255 - LOG[a]]
end

-- Multiply two polynomials represented highest-degree first
function M.poly_mul(p, q)
    local lp = len(p)
    local lq = len(q)
    local out = int_array(lp + lq - 1)
    for _ = 0, lp + lq - 2 do
        out[] = 0
    end
    for i = 0, lp - 1 do
        local pi = p[i]
        if pi ~= 0 then
            local log_pi = LOG[pi]
            for j = 0, lq - 1 do
                local qj = q[j]
                if qj ~= 0 then
                    out[i + j] = out[i + j] ~ EXP[log_pi + LOG[qj]]
                end
            end
        end
    end
    return out
end

-- Cache of generator polynomials by nsym
local gen_cache = [=]

-- generator_poly(nsym) → int_array of length nsym + 1 (highest-degree first, gen[0] == 1)
function M.generator_poly(nsym)
    local cached = gen_cache[nsym]
    if cached ~= nil then
        return cached
    end
    local g = int_array(1)
    g[] = 1
    for i = 0, nsym - 1 do
        local factor = int_array(2)
        factor[] = 1
        factor[] = EXP[i]
        g = M.poly_mul(g, factor)
    end
    gen_cache[nsym] = g
    return g
end

-- rs.encode(data_bytes, nsym) → int_array(nsym) of error-correction codewords
function M.encode(data_bytes, nsym)
    local gen = M.generator_poly(nsym)
    local rem = int_array(nsym)
    for _ = 0, nsym - 1 do
        rem[] = 0
    end
    local ndata = len(data_bytes)
    for i = 0, ndata - 1 do
        local factor = data_bytes[i] ~ rem[0]
        for j = 0, nsym - 2 do
            rem[j] = rem[j + 1]
        end
        rem[nsym - 1] = 0
        if factor ~= 0 then
            local log_f = LOG[factor]
            for j = 0, nsym - 1 do
                local gj = gen[j + 1]
                if gj ~= 0 then
                    rem[j] = rem[j] ~ EXP[log_f + LOG[gj]]
                end
            end
        end
    end
    return rem
end

-- Evaluate polynomial (highest-degree first) at x in GF(2^8)
function M.poly_eval(poly, x)
    local n = len(poly)
    if n == 0 then
        return 0
    end
    if x == 0 then
        return poly[n - 1]
    end
    local res = poly[0]
    local log_x = LOG[x]
    for i = 1, n - 1 do
        if res ~= 0 then
            res = EXP[LOG[res] + log_x] ~ poly[i]
        else
            res = poly[i]
        end
    end
    return res
end

-- Compute syndromes S_0 .. S_{nsym-1} where S_i = C(alpha^i)
function M.syndromes(cw, nsym)
    local synd = int_array(nsym)
    local all_zero = true
    for i = 0, nsym - 1 do
        local s = M.poly_eval(cw, EXP[i])
        synd[] = s
        if s ~= 0 then
            all_zero = false
        end
    end
    return synd, all_zero
end

-- Evaluate polynomial stored lowest-degree first: P(z) = sum_{d=0}^{k} p[d] * z^d
local function poly_eval_low(p, x)
    local n = len(p)
    local acc = 0
    for d = n - 1, 0, -1 do
        acc = M.gf_mul(acc, x) ~ p[d]
    end
    return acc
end

-- rs.decode(codeword, nsym) → { data = int_array, codeword = int_array, errors_corrected = int }|error
-- Corrects up to floor(nsym / 2) byte errors in `codeword` using Berlekamp-Massey,
-- Chien search, and Forney's algorithm.
function M.decode(codeword, nsym)
    local n = len(codeword)
    if n <= nsym then
        return error("reed_solomon.decode: codeword length must exceed nsym")
    end
    local cw = int_array(n)
    for i = 0, n - 1 do
        cw[] = codeword[i] & 0xFF
    end

    local synd, clean = M.syndromes(cw, nsym)
    local data_len = n - nsym
    if clean then
        local data = int_array(data_len)
        for i = 0, data_len - 1 do
            data[] = cw[i]
        end
        return {data = data, codeword = cw, errors_corrected = 0}
    end

    -- 1. Berlekamp-Massey algorithm to find error locator polynomial C(z) = 1 + C_1 z + ... + C_L z^L
    local C = [1]
    local B = [1]
    local L = 0
    local m_shift = 1
    local b = 1

    for step = 0, nsym - 1 do
        local d = synd[step]
        for i = 1, L do
            if i < len(C) and C[i] ~= 0 and synd[step - i] ~= 0 then
                d = d ~ M.gf_mul(C[i], synd[step - i])
            end
        end
        if d == 0 then
            m_shift += 1
        else
            local T = []
            for _, v in C do T[] = v end
            local coef = M.gf_div(d, b)
            local needed = len(B) + m_shift
            while len(C) < needed do
                C[] = 0
            end
            for i = 0, len(B) - 1 do
                if B[i] ~= 0 then
                    C[i + m_shift] = C[i + m_shift] ~ M.gf_mul(coef, B[i])
                end
            end
            if 2 * L <= step then
                L = step + 1 - L
                B = T
                b = d
                m_shift = 1
            else
                m_shift += 1
            end
        end
    end

    if L > nsym // 2 then
        return error(`reed_solomon.decode: too many errors (${L} > ${nsym // 2})`)
    end

    -- 2. Chien search: find array positions p in 0..n-1 where C(X_p^{-1}) == 0,
    -- with X_p = alpha^(n - 1 - p).
    local err_pos = []
    local err_X = []
    for p = 0, n - 1 do
        local power = (n - 1 - p) % 255
        local X = EXP[power]
        local X_inv = M.gf_inv(X)
        if poly_eval_low(C, X_inv) == 0 then
            err_pos[] = p
            err_X[] = X
        end
    end

    if len(err_pos) ~= L then
        return error(`reed_solomon.decode: Chien search found ${len(err_pos)} roots, expected ${L}`)
    end

    -- 3. Compute error evaluator polynomial Omega(z) = S(z) * C(z) mod z^nsym (lowest-degree first)
    local omega = []
    for k = 0, nsym - 1 do
        local sum = 0
        for i = 0, k do
            if i < len(C) and (k - i) < nsym then
                sum = sum ~ M.gf_mul(synd[k - i], C[i])
            end
        end
        omega[] = sum
    end

    -- 4. Forney's algorithm: e_m = X_m * Omega(X_m^{-1}) / C'(X_m^{-1})
    for m = 0, L - 1 do
        local X = err_X[m]
        local X_inv = M.gf_inv(X)
        local num = poly_eval_low(omega, X_inv)
        -- Formal derivative C'(X_inv) = sum_{odd i} C[i] * X_inv^(i - 1)
        local den = 0
        local x_pow = 1 -- X_inv^0
        local x_inv_sq = M.gf_mul(X_inv, X_inv)
        for i = 1, len(C) - 1, 2 do
            if C[i] ~= 0 then
                den = den ~ M.gf_mul(C[i], x_pow)
            end
            x_pow = M.gf_mul(x_pow, x_inv_sq)
        end
        if den == 0 then
            return error("reed_solomon.decode: zero denominator in Forney algorithm")
        end
        local mag = M.gf_mul(X, M.gf_div(num, den))
        local pos = err_pos[m]
        cw[pos] = cw[pos] ~ mag
    end

    -- 5. Verify repaired codeword has zero syndromes
    local _, ok_after = M.syndromes(cw, nsym)
    if not ok_after then
        return error("reed_solomon.decode: syndrome check failed after correction")
    end

    local data = int_array(data_len)
    for i = 0, data_len - 1 do
        data[] = cw[i]
    end
    return {data = data, codeword = cw, errors_corrected = L}
end

return M
