-- tools/gen_sjis.sea — writes sjis.sea: the character of each QR Kanji value.
--
-- QR's Kanji mode stores a Shift JIS (JIS X 0208) double-byte character as a
-- 13-bit value (ISO/IEC 18004 7.4.6). This asks iconv for the Unicode of every
-- value and writes them as one string of 8192 characters (U+FFFD where there is
-- none). Run from the repository: sea tools/gen_sjis.sea
local COUNT = 8192

local lines = []
for v = 0, COUNT - 1 do
    local prod = ((v // 0xC0) << 8) | (v % 0xC0)
    local sjis = prod + ((prod < 0x1F00) and 0x8140 or 0xC140)
    lines[] = string.char((sjis >> 8) & 0xFF, sjis & 0xFF)
end
local r = process.run(["iconv", "-c", "-f", "SHIFT_JIS", "-t", "UTF-8"], {stdin = string.join(lines, "\n") .. "\n"})?
local out = string.splitlines(r.stdout)
if len(out) < COUNT then return error(`gen_sjis: iconv gave ${len(out)} lines, expected ${COUNT}`) end

-- iconv -c drops an invalid lead byte and may decode the trail byte alone
-- (as ASCII or half-width katakana): keep a character only if it converts
-- back to exactly the two bytes it came from
local back_in = []
for v = 0, COUNT - 1 do back_in[] = out[v] end
local rb = process.run(["iconv", "-c", "-f", "UTF-8", "-t", "SHIFT_JIS"], {stdin = string.join(back_in, "\n") .. "\n"})?
local back = string.split(rb.stdout, "\n")

local chars = []
local found = 0
for v = 0, COUNT - 1 do
    local c = out[v]
    if c ~= "" and utf8.len(c) == 1 and back[v] == lines[v] then
        chars[] = c
        found += 1
    else
        chars[] = "\u{FFFD}"
    end
end

local src = [
    "-- sjis.sea — generated by tools/gen_sjis.sea (iconv SHIFT_JIS): do not edit.",
    "-- The character of each QR Kanji value 0..8191 (U+FFFD: none).",
    "return string.join([",
]
local per_line = 64
for i = 0, COUNT - 1, per_line do
    local piece = []
    for k = i, math.min(i + per_line, COUNT) - 1 do piece[] = chars[k] end
    src[] = "    \"" .. string.join(piece, "") .. "\","
end
src[] = "], \"\")"
fs.write("sjis.sea", string.join(src, "\n") .. "\n")?
print(`sjis.sea: ${found} characters`)
