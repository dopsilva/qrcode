-- matrix.sea — QR Code 2D module matrix, function patterns, masking, and ISO 18004 penalty evaluation.

local tables = require("./tables")

local M = {}

local Matrix = {}

-- mat:get(x, y) → 0 (light) or 1 (dark)
function Matrix.get(self, x, y)
    if x < 0 or x >= self.size or y < 0 or y >= self.size then
        return 0
    end
    return self.modules[y * self.size + x]
end

-- mat:set(x, y, val) → sets module at (x, y) to 0 or 1
function Matrix.set(self, x, y, val)
    if x < 0 or x >= self.size or y < 0 or y >= self.size then
        return
    end
    self.modules[y * self.size + x] = (val ~= 0 and val ~= false) and 1 or 0
end

-- mat:set_func(x, y, val) → sets a function pattern module and marks it reserved
function Matrix.set_func(self, x, y, val)
    if x < 0 or x >= self.size or y < 0 or y >= self.size then
        return
    end
    local idx = y * self.size + x
    self.modules[idx] = (val ~= 0 and val ~= false) and 1 or 0
    self.is_func[idx] = 1
end

-- mat:is_function(x, y) → bool
function Matrix.is_function(self, x, y)
    if x < 0 or x >= self.size or y < 0 or y >= self.size then
        return false
    end
    return self.is_func[y * self.size + x] ~= 0
end

-- mat:clone() → Matrix
function Matrix.clone(self)
    local out = M.new(self.size, self.version)
    local n = self.size * self.size
    for i = 0, n - 1 do
        out.modules[i] = self.modules[i]
        out.is_func[i] = self.is_func[i]
    end
    return out
end

-- matrix.new(size [, version]) → Matrix
function M.new(size, version)
    local ver = version or tables.size_to_version(size) or 1
    local n = size * size
    local modules = int_array(n)
    local is_func = int_array(n)
    for _ = 0, n - 1 do
        modules[] = 0
        is_func[] = 0
    end
    local mat = {}
    mat.size = size
    mat.version = ver
    mat.modules = modules
    mat.is_func = is_func
    for k, fn in Matrix do
        mat[k] = fn
    end
    return mat
end

-- Draw a 7x7 finder pattern with its 1-module white separator at top-left corner (ox, oy)
local function draw_finder(mat, ox, oy)
    for iy = 0, 8 do
        local dy = iy - 1
        for ix = 0, 8 do
            local dx = ix - 1
            local x = ox + dx
            local y = oy + dy
            if x >= 0 and x < mat.size and y >= 0 and y < mat.size then
                local dark = 0
                if dx >= 0 and dx <= 6 and dy >= 0 and dy <= 6 then
                    if dx == 0 or dx == 6 or dy == 0 or dy == 6 or (dx >= 2 and dx <= 4 and dy >= 2 and dy <= 4) then
                        dark = 1
                    end
                end
                mat:set_func(x, y, dark)
            end
        end
    end
end

-- Draw a 5x5 alignment pattern centered at (cx, cy)
local function draw_alignment(mat, cx, cy)
    for iy = 0, 4 do
        local dy = iy - 2
        for ix = 0, 4 do
            local dx = ix - 2
            local dist = math.max(math.abs(dx), math.abs(dy))
            local dark = (dist ~= 1) and 1 or 0
            mat:set_func(cx + dx, cy + dy, dark)
        end
    end
end

-- Reserve and optionally write the 15-bit format info into both standard regions
function M.write_format_info(mat, ec_level, mask)
    local fbits = tables.format_bits(ec_level, mask)
    local s = mat.size

    -- Copy 1: around top-left finder
    -- Horizontal row y = 8: x = 0..5 (bits 14..9), x = 7 (bit 8), x = 8 (bit 7)
    local x_coords_1 = [0, 1, 2, 3, 4, 5, 7, 8]
    for i = 0, 7 do
        local bit = (fbits >> (14 - i)) & 1
        mat:set_func(x_coords_1[i], 8, bit)
    end
    -- Vertical col x = 8: y = 7 (bit 6), y = 5..0 (bits 5..0)
    local y_coords_1 = [7, 5, 4, 3, 2, 1, 0]
    for i = 0, 6 do
        local bit = (fbits >> (6 - i)) & 1
        mat:set_func(8, y_coords_1[i], bit)
    end

    -- Copy 2: bottom-left vertical (bits 14..8) and top-right horizontal (bits 7..0)
    for i = 0, 6 do
        local bit = (fbits >> (14 - i)) & 1
        mat:set_func(8, s - 1 - i, bit)
    end
    for i = 0, 7 do
        local bit = (fbits >> (7 - i)) & 1
        mat:set_func(s - 8 + i, 8, bit)
    end

    -- Fixed dark module at (8, s - 8)
    mat:set_func(8, s - 8, 1)
end

-- Read both 15-bit format info copies from a matrix and decode via BCH
function M.read_format_info(mat)
    local s = mat.size
    local f1 = 0
    local x_coords_1 = [0, 1, 2, 3, 4, 5, 7, 8]
    for i = 0, 7 do
        f1 = (f1 << 1) | (mat:get(x_coords_1[i], 8) & 1)
    end
    local y_coords_1 = [7, 5, 4, 3, 2, 1, 0]
    for i = 0, 6 do
        f1 = (f1 << 1) | (mat:get(8, y_coords_1[i]) & 1)
    end

    local f2 = 0
    for i = 0, 6 do
        f2 = (f2 << 1) | (mat:get(8, s - 1 - i) & 1)
    end
    for i = 0, 7 do
        f2 = (f2 << 1) | (mat:get(s - 8 + i, 8) & 1)
    end

    local dec1 = tables.decode_format_bits(f1)
    local dec2 = tables.decode_format_bits(f2)
    if dec1 and dec2 then
        if dec1.errors <= dec2.errors then
            return dec1
        else
            return dec2
        end
    end
    return dec1 or dec2
end

-- Write 18-bit version info for version >= 7
function M.write_version_info(mat, version)
    if version < 7 then
        return
    end
    local vbits = tables.version_bits(version)
    local s = mat.size
    for i = 0, 17 do
        local bit = (vbits >> i) & 1
        local a = s - 11 + (i % 3)
        local b = i // 3
        mat:set_func(b, a, bit)
        mat:set_func(a, b, bit)
    end
end

-- Read 18-bit version info from a matrix of size >= 45 (version >= 7)
function M.read_version_info(mat)
    local s = mat.size
    if s < 45 then
        local v = tables.size_to_version(s)
        if v then
            return {version = v, errors = 0}
        end
        return nil
    end
    local v1 = 0
    local v2 = 0
    for i = 17, 0, -1 do
        local a = s - 11 + (i % 3)
        local b = i // 3
        v1 = (v1 << 1) | (mat:get(b, a) & 1)
        v2 = (v2 << 1) | (mat:get(a, b) & 1)
    end
    local dec1 = tables.decode_version_bits(v1)
    local dec2 = tables.decode_version_bits(v2)
    if dec1 and dec2 then
        if dec1.errors <= dec2.errors then
            return dec1
        else
            return dec2
        end
    end
    return dec1 or dec2
end

-- Populate all function patterns on a fresh matrix for `version`
function M.setup_function_patterns(mat)
    local ver = mat.version
    local s = mat.size

    -- 1. Three Finder Patterns + Separators
    draw_finder(mat, 0, 0)
    draw_finder(mat, s - 7, 0)
    draw_finder(mat, 0, s - 7)

    -- 2. Alignment Patterns (Version >= 2)
    local apos = tables.ALIGNMENT_POS[ver]
    local k = len(apos)
    if k > 0 then
        for i = 0, k - 1 do
            for j = 0, k - 1 do
                local is_corner = (i == 0 and j == 0) or (i == 0 and j == k - 1) or (i == k - 1 and j == 0)
                if not is_corner then
                    draw_alignment(mat, apos[i], apos[j])
                end
            end
        end
    end

    -- 3. Timing Patterns (row 6 and col 6)
    for i = 8, s - 9 do
        local bit = (i % 2 == 0) and 1 or 0
        if not mat:is_function(i, 6) then
            mat:set_func(i, 6, bit)
        end
        if not mat:is_function(6, i) then
            mat:set_func(6, i, bit)
        end
    end

    -- 4. Reserve Format Info & Dark Module (placeholder mask 0)
    M.write_format_info(mat, "M", 0)

    -- 5. Reserve Version Info (Version >= 7)
    if ver >= 7 then
        M.write_version_info(mat, ver)
    end
end

-- Return ordered list of data/EC module coordinates [x0, y0, x1, y1, ...] in standard zigzag order
function M.zigzag_coords(mat)
    local s = mat.size
    local coords = int_array(s * s * 2)
    local right = s - 1
    local upward = true

    while right >= 1 do
        if right == 6 then
            right = 5 -- Skip vertical timing pattern column
        end
        for step = 0, s - 1 do
            local y = upward and (s - 1 - step) or step
            for dx = 0, 1 do
                local x = right - dx
                if not mat:is_function(x, y) then
                    coords[] = x
                    coords[] = y
                end
            end
        end
        upward = not upward
        right -= 2
    end
    return coords
end

-- Place codeword bytes + remainder bits into non-function modules
function M.place_codewords(mat, codewords)
    local coords = M.zigzag_coords(mat)
    local n_modules = len(coords) // 2
    local n_cw = len(codewords)
    local bit_idx = 0

    for m = 0, n_modules - 1 do
        local x = coords[m * 2]
        local y = coords[m * 2 + 1]
        local byte_idx = bit_idx >> 3
        local bit = 0
        if byte_idx < n_cw then
            local shift = 7 - (bit_idx & 7)
            bit = (codewords[byte_idx] >> shift) & 1
        end
        mat:set(x, y, bit)
        bit_idx += 1
    end
end

-- Extract codeword bytes from non-function modules
function M.extract_codewords(mat)
    local coords = M.zigzag_coords(mat)
    local n_modules = len(coords) // 2
    local total_cw = tables.TOTAL_CODEWORDS[mat.version] or (n_modules // 8)
    local out = int_array(total_cw)
    for c = 0, total_cw - 1 do
        local byte_val = 0
        local base_bit = c * 8
        for b = 0, 7 do
            local m = base_bit + b
            local bit = 0
            if m < n_modules then
                local x = coords[m * 2]
                local y = coords[m * 2 + 1]
                bit = mat:get(x, y) & 1
            end
            byte_val = (byte_val << 1) | bit
        end
        out[] = byte_val
    end
    return out
end

-- Evaluate mask condition (0..7) at row r (y) and column c (x)
function M.mask_bit(mask, x, y)
    local r = y
    local c = x
    if mask == 0 then
        return ((r + c) % 2 == 0) and 1 or 0
    elseif mask == 1 then
        return (r % 2 == 0) and 1 or 0
    elseif mask == 2 then
        return (c % 3 == 0) and 1 or 0
    elseif mask == 3 then
        return ((r + c) % 3 == 0) and 1 or 0
    elseif mask == 4 then
        return (((r // 2) + (c // 3)) % 2 == 0) and 1 or 0
    elseif mask == 5 then
        return (((r * c) % 2) + ((r * c) % 3) == 0) and 1 or 0
    elseif mask == 6 then
        return ((((r * c) % 2) + ((r * c) % 3)) % 2 == 0) and 1 or 0
    elseif mask == 7 then
        return ((((r + c) % 2) + ((r * c) % 3)) % 2 == 0) and 1 or 0
    end
    return 0
end

-- Toggle data modules in-place with `mask` (0..7)
function M.apply_mask(mat, mask)
    local s = mat.size
    for y = 0, s - 1 do
        local row_off = y * s
        for x = 0, s - 1 do
            local idx = row_off + x
            if mat.is_func[idx] == 0 then
                if M.mask_bit(mask, x, y) == 1 then
                    mat.modules[idx] = mat.modules[idx] ~ 1
                end
            end
        end
    end
end

-- Helper for ISO 18004 Rule 3 penalty: checks 1:1:3:1:1 with 4 light modules on either side
local function finder_penalty_line(line, s)
    local penalty = 0
    -- Pattern 1011101 with 0000 before or 0000 after
    for i = 0, s - 7 do
        if line[i] == 1 and line[i + 1] == 0 and line[i + 2] == 1 and line[i + 3] == 1 and
            line[i + 4] == 1 and line[i + 5] == 0 and line[i + 6] == 1 then
            local left_white = (i >= 4) and
                (line[i - 1] == 0 and line[i - 2] == 0 and line[i - 3] == 0 and line[i - 4] == 0)
            local right_white = (i + 10 < s) and
                (line[i + 7] == 0 and line[i + 8] == 0 and line[i + 9] == 0 and line[i + 10] == 0)
            if left_white or right_white then
                penalty += 40
            end
        end
    end
    return penalty
end

-- Compute the total ISO/IEC 18004 penalty score for a masked matrix
function M.penalty_score(mat)
    local s = mat.size
    local mods = mat.modules
    local score = 0
    local line = int_array(s)
    for _ = 0, s - 1 do line[] = 0 end

    -- Rule 1 (rows & cols): 5+ consecutive same-color modules -> 3 + (run - 5)
    -- Rule 3 (rows & cols): 1:1:3:1:1 finder-like pattern with 4 white modules -> +40
    for y = 0, s - 1 do
        local row_off = y * s
        local run_color = mods[row_off]
        local run_len = 1
        line[0] = run_color
        for x = 1, s - 1 do
            local c = mods[row_off + x]
            line[x] = c
            if c == run_color then
                run_len += 1
            else
                if run_len >= 5 then
                    score += 3 + (run_len - 5)
                end
                run_color = c
                run_len = 1
            end
        end
        if run_len >= 5 then
            score += 3 + (run_len - 5)
        end
        score += finder_penalty_line(line, s)
    end

    for x = 0, s - 1 do
        local run_color = mods[x]
        local run_len = 1
        line[0] = run_color
        for y = 1, s - 1 do
            local c = mods[y * s + x]
            line[y] = c
            if c == run_color then
                run_len += 1
            else
                if run_len >= 5 then
                    score += 3 + (run_len - 5)
                end
                run_color = c
                run_len = 1
            end
        end
        if run_len >= 5 then
            score += 3 + (run_len - 5)
        end
        score += finder_penalty_line(line, s)
    end

    -- Rule 2: 2x2 blocks of same color -> +3 each
    for y = 0, s - 2 do
        local r0 = y * s
        local r1 = (y + 1) * s
        for x = 0, s - 2 do
            local c = mods[r0 + x]
            if c == mods[r0 + x + 1] and c == mods[r1 + x] and c == mods[r1 + x + 1] then
                score += 3
            end
        end
    end

    -- Rule 4: Proportion of dark modules relative to 50% in steps of 5% -> * 10
    local dark = 0
    local total = s * s
    for i = 0, total - 1 do
        dark += mods[i]
    end
    local k = (math.abs(dark * 20 - total * 10) + total - 1) // total - 1
    if k > 0 then
        score += k * 10
    end

    return score
end

return M
